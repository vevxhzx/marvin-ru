# Единый стиль строк: Windows-скрипты — CRLF, всё остальное — LF.
# Без этого zip-архив релиза с LF-метками ломает .bat в cmd.exe.

* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.command text eol=lf

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.db binary
