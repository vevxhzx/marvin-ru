# Marvin — переменные окружения (пример)
#
# Скопируйте в .env в корне проекта: run.py / voice_client.py подхватывают этот файл
# через core/config.py при старте. Переменные, уже заданные в системе, не перезаписываются.
# Порядок: переменная окружения > .env > config.yaml
#
# Python-ядро (run.py) слушает server.port из config.yaml — здесь этот порт не задаётся.

# Порт Node-демо (server.ts / desktop.mjs) — только в переменных окружения ОС:
# Node не читает .env, задавайте через `set PORT=...` (Windows) / `PORT=...` (Unix) либо в Docker `environment:`
PORT=3000
# Адрес Node-демо (по умолчанию 127.0.0.1 — только локально; открыть наружу: HOST=0.0.0.0)
HOST=127.0.0.1
# Дополнительные origin'ы для CORS Node-демо, через запятую (например https://example.com)
ALLOWED_ORIGINS=

# Ключ Gemini для облачного режима мозга (core/config.py)
GEMINI_API_KEY=

# Токен Telegram-бота (core/config.py → telegram.token); можно и в мастере настройки
ASSISTANT_TG_TOKEN=

# Telegram ID владельца (core/config.py → telegram.owner_id)
ASSISTANT_TG_OWNER=

# Адрес Ollama (Docker: http://ollama:11434; core/config.py → brain.ollama.url)
OLLAMA_URL=

# Отключить прогрев голосовых моделей при старте (run.py) — удобно в dev/тестах
ASSISTANT_NO_VOICE_WARMUP=

# Режим Docker (run.py: ссылка на мастер настройки вместо первого запуска)
ASSISTANT_DOCKER=
