# Джарвис — переменные окружения (пример, значений здесь нет)
#
# Скопируй этот файл в `.env` и заполни своими значениями.
# `.env` читается на старте (core/config.py) и лежит в .gitignore — в git он не попадает.
# Порядок приоритета: переменная окружения > .env > config.yaml.
#
# Ничего из этого заполнять не обязательно: всё настраивается в config.yaml.
# Строки ниже — только для запуска из Docker/CI или чтобы переопределить config.yaml.
#
# Node-стенд (server.ts / desktop.mjs) .env НЕ читает: задавай PORT/HOST
# через `set PORT=...` (Windows), `PORT=...` (Unix) или `environment:` в Docker.
#
# Порт HTTP-сервера Python (иначе server.port из config.yaml, по умолчанию 8765)
PORT=

# Хост Node-стенда (по умолчанию 127.0.0.1; Docker: HOST=0.0.0.0)
HOST=

# Разрешённые origin'ы для CORS Node-стенда (через запятую, например https://example.com)
ALLOWED_ORIGINS=

# Ключ Gemini (core/config.py → brain.gemini.key)
GEMINI_API_KEY=

# Токен Telegram-бота (core/config.py → telegram.token); можно вместо config.yaml
ASSISTANT_TG_TOKEN=
# Старое имя переменной (поддерживается для совместимости):
JARVIS_TG_TOKEN=

# Telegram ID владельца (core/config.py → telegram.owner_id)
ASSISTANT_TG_OWNER=
# Старое имя переменной (поддерживается для совместимости):
JARVIS_TG_OWNER=

# URL Ollama (Docker: http://ollama:11434; core/config.py → brain.ollama.url)
OLLAMA_URL=

# Отключить прогрев голоса на старте (run.py; полезно в dev/CI)
ASSISTANT_NO_VOICE_WARMUP=

# Отключить автозапуск браузера (run.py)
ASSISTANT_NO_BROWSER=

# Режим Docker (run.py: скрыть проверки звука и другие Docker-ограничения)
ASSISTANT_DOCKER=

# Тестовый режим (core/api/auth.py: обход авторизации; НИКОГДА не включай на своей машине)
ASSISTANT_TEST=
JARVIS_TEST=
