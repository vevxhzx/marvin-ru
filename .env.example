# Джарвис — переменные окружения (пример, значений здесь нет)
#
# Скопируй этот файл в `.env` и заполни своими значениями.
# `.env` читается на старте (core/config.py) и лежит в .gitignore — в git он не попадает.
# Порядок приоритета: переменная окружения > .env > config.yaml.
#
# Ничего из этого заполнять не обязательно: всё настраивается в config.yaml.
# Строки ниже — только для запуска из Docker/CI или чтобы переопределить config.yaml.
#
# Node-стенд (server.ts) .env читает сам (server.ts:17-27, без dotenv):
# подхватываются только не заданные в окружении ключи; Python-ядро их не использует.
# Для Node-стенда задавай PORT / HOST / ALLOWED_ORIGINS / LLM_* (LLM_API_KEY, LLM_URL,
# LLM_MODEL) либо через окружение (`set PORT=...`, `PORT=...`, `environment:` в Docker).
#
# Порт HTTP-сервера Python (иначе server.port из config.yaml, по умолчанию 8765)
PORT=

# Хост Node-стенда (по умолчанию 127.0.0.1; Docker: HOST=0.0.0.0)
HOST=

# Разрешённые origin'ы для CORS Node-стенда (через запятую, например https://example.com)
ALLOWED_ORIGINS=

# Ключ Gemini (core/config.py → brain.gemini.key)
GEMINI_API_KEY=

# Ключ облака (core/config.py → brain.cloud.api_key; groq/openrouter/другие провайдеры)
CLOUD_API_KEY=

# Google OAuth для календаря (core/config.py → google.client_id / google.client_secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключ доступа к ядру с другой машины (core/config.py → voice.pc.api_token; иначе data/api_token)
ASSISTANT_API_TOKEN=
# Старое имя переменной (поддерживается для совместимости):
# DEPRECATED: используйте ASSISTANT_API_TOKEN (JARVIS_* будут удалены через 2 релиза)
JARVIS_API_TOKEN=

# Токен Telegram-бота (core/config.py → telegram.token); можно вместо config.yaml
ASSISTANT_TG_TOKEN=
# Старое имя переменной (поддерживается для совместимости):
# DEPRECATED: используйте ASSISTANT_TG_TOKEN (JARVIS_* будут удалены через 2 релиза)
JARVIS_TG_TOKEN=

# Telegram ID владельца (core/config.py → telegram.owner_id)
ASSISTANT_TG_OWNER=
# Старое имя переменной (поддерживается для совместимости):
# DEPRECATED: используйте ASSISTANT_TG_OWNER (JARVIS_* будут удалены через 2 релиза)
JARVIS_TG_OWNER=

# URL Ollama (Docker: http://ollama:11434; core/config.py → brain.ollama.url)
OLLAMA_URL=

# Отключить прогрев голоса на старте (run.py; полезно в dev/CI)
ASSISTANT_NO_VOICE_WARMUP=

# Отключить автозапуск браузера (run.py)
ASSISTANT_NO_BROWSER=

# Режим Docker (run.py: скрыть проверки звука и другие Docker-ограничения)
ASSISTANT_DOCKER=

# Тестовый режим (core/api/auth.py: обход авторизации; НИКОГДА не включай на своей машине)
ASSISTANT_TEST=
# DEPRECATED: используйте ASSISTANT_TEST (JARVIS_* будут удалены через 2 релиза)
JARVIS_TEST=

# Порт для окна приложения jarvis_app.py (иначе server.port из config.yaml)
ASSISTANT_PORT=

# Куда качать модели распознавания (по умолчанию ~/.cache/huggingface; полезно, если мало места на C:)
HF_HOME=

# ---- Старые имена (поддерживаются для совместимости) ----
# DEPRECATED: используйте ASSISTANT_NO_VOICE_WARMUP (JARVIS_* будут удалены через 2 релиза)
JARVIS_NO_VOICE_WARMUP=
# DEPRECATED: используйте ASSISTANT_NO_BROWSER (JARVIS_* будут удалены через 2 релиза)
JARVIS_NO_BROWSER=
# DEPRECATED: используйте ASSISTANT_DOCKER (JARVIS_* будут удалены через 2 релиза)
JARVIS_DOCKER=

# ---- Пути (core/config.py): пригодятся для тестов на временной БД и для второго экземпляра ----
# Папка данных вместо data/ (api_token, картинки, кэш, сессия Telegram)
# DEPRECATED: используйте ASSISTANT_DATA_DIR (JARVIS_* будут удалены через 2 релиза)
JARVIS_DATA_DIR=
ASSISTANT_DATA_DIR=
# Файл настроек вместо config.yaml
# DEPRECATED: используйте ASSISTANT_CONFIG (JARVIS_* будут удалены через 2 релиза)
JARVIS_CONFIG=
ASSISTANT_CONFIG=
# Файл базы вместо data/jarvis.db
# DEPRECATED: используйте ASSISTANT_DB_PATH (JARVIS_* будут удалены через 2 релиза)
JARVIS_DB_PATH=
ASSISTANT_DB_PATH=

# Сколько секунд ждать завершения фоновых задач при остановке ядра (run.py, по умолчанию 8)
# DEPRECATED: имя JARVIS_* устарело (JARVIS_* будут удалены через 2 релиза)
JARVIS_SHUTDOWN_TIMEOUT=

# ---- Только для Node-стенда server.ts (Python-ядро их не использует) ----
# LLM_API_KEY=
# LLM_URL=
# LLM_MODEL=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
