# Marvin — переменные окружения (пример; значений здесь нет)
#
# Скопируйте файл в `.env` и заполните своими значениями.
# `.env` читается на старте (core/config.py) и лежит в .gitignore — в git он не попадает.
# Приоритет: переменная окружения > .env > config.yaml.
#
# Заполнять ничего не обязательно: всё настраивается в config.yaml,
# а `install.bat` / `install.sh` запускают мастер первого запуска и сами создают .env.

# --- Telegram ---
# Токен бота от @BotFather (config.yaml → telegram.token)
ASSISTANT_TG_TOKEN=
# Ваш Telegram ID: узнать можно, написав боту /start (config.yaml → telegram.owner_id)
ASSISTANT_TG_OWNER=

# --- Локальный мозг (Ollama) — нужен для режимов local и hybrid ---
# Адрес Ollama; в Docker обычно http://ollama:11434 (config.yaml → brain.ollama.url)
OLLAMA_URL=
# Имя модели Ollama, если не хотите задавать в config.yaml (config.yaml → brain.ollama.model)
OLLAMA_MODEL=

# --- Ключ облачной модели — нужен только для режимов hybrid и cloud ---
# Обычно ключ задают в config.yaml (brain.cloud.api_key) или в мастере первого запуска.
# Переменной окружения можно задать только ключ Gemini:
GEMINI_API_KEY=

# --- Сервер ---
# Порт окна-приложения desktop_app.py (иначе server.port из config.yaml; сам HTTP-сервер слушает server.host)
ASSISTANT_PORT=

# --- Голос ---
# Куда качать модели распознавания речи (по умолчанию ~/.cache/huggingface; полезно, если мало места на системном диске)
HF_HOME=

# --- Полезно в dev / Docker / CI (в обычной работе не нужно) ---
ASSISTANT_NO_VOICE_WARMUP=   # не прогревать голос на старте
ASSISTANT_NO_BROWSER=        # не открывать браузер при старте
ASSISTANT_DOCKER=            # режим Docker: скрыть проверки звука и прочие ограничения
ASSISTANT_TEST=              # только для тестов: обход авторизации. НИКОГДА не включайте у себя

# --- Только для Node-стенда (server.ts) — Python-ядро эти переменные не использует ---
# PORT=
# HOST=
# ALLOWED_ORIGINS=
# LLM_API_KEY=
# LLM_URL=
# LLM_MODEL=
