# Marvin Environment Configuration Example
# Copy to .env or configure via config.yaml

PORT=3000
HOST=0.0.0.0

# Optional Server-Side Gemini API Key (if using Cloud Brain mode)
GEMINI_API_KEY=

# Optional Telegram Bot Token (can also be set via config.yaml or setup wizard)
TELEGRAM_BOT_TOKEN=

# Optional disable voice warmup in dev / test environments
ASSISTANT_NO_VOICE_WARMUP=
